rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function enabled() {
      return signedIn() && request.auth.token.email_verified == true && profile().active == true;
    }
    function customer() { return enabled() && profile().role == 'customer'; }
    function admin() { return enabled() && profile().role == 'admin'; }
    function technician() { return enabled() && profile().role == 'technician'; }
    function bounded(max) { return request.query.limit != null && request.query.limit <= max; }
    function activeStatus(status) { return status in ['pending', 'confirmed']; }

    match /users/{uid} {
      allow get: if (signedIn() && uid == request.auth.uid) || (admin() && resource.data.role == 'technician');
      allow create: if signedIn() && uid == request.auth.uid
        && request.resource.data.keys().hasAll(['email', 'role', 'active', 'createdAt'])
        && request.resource.data.keys().hasOnly(['email', 'role', 'active', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'customer'
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time;
      // Roles and deactivation are managed only through the trusted Admin SDK/console.
      allow update, delete, list: if false;
    }

    match /vehicles/{id} {
      function valid(d) {
        return d.keys().hasAll(['ownerId', 'name', 'plate', 'active', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['ownerId', 'name', 'plate', 'active', 'createdAt', 'updatedAt'])
          && d.ownerId == request.auth.uid && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.plate is string && d.plate.matches('^[A-Z]{1,2} [0-9]{1,4}( [A-Z]{1,3})?$')
          && d.active is bool && d.createdAt is timestamp && d.updatedAt == request.time;
      }
      allow get: if customer() && resource.data.ownerId == request.auth.uid;
      allow list: if customer() && bounded(50) && resource.data.ownerId == request.auth.uid;
      allow create: if customer() && valid(request.resource.data)
        && request.resource.data.active == true && request.resource.data.createdAt == request.time;
      allow update: if customer() && resource.data.ownerId == request.auth.uid && resource.data.active == true
        && valid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'plate', 'active', 'updatedAt']);
      allow delete: if false;
    }

    match /services/{id} {
      function valid(d) {
        return d.keys().hasAll(['name', 'active', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['name', 'active', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.active is bool && d.createdAt is timestamp && d.updatedAt == request.time;
      }
      allow get: if enabled() && (resource.data.active == true || admin());
      allow list: if enabled() && bounded(50) && (resource.data.active == true || admin());
      allow create: if admin() && valid(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if admin() && valid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'active', 'updatedAt']);
      allow delete: if false;
    }

    match /bookings/{id} {
      function slot(d) { return getAfter(/databases/$(database)/documents/bookingSlots/$(d.slotId)).data; }
      function lockMatches(d, active) {
        return slot(d).bookingId == id && slot(d).scheduledAt == d.scheduledAt && slot(d).active == active;
      }
      function validCreate(d) {
        let vehicle = get(/databases/$(database)/documents/vehicles/$(d.vehicleId)).data;
        let catalog = get(/databases/$(database)/documents/services/$(d.serviceId)).data;
        return d.keys().hasAll(['customerId', 'vehicleId', 'vehicleName', 'vehiclePlate', 'serviceId', 'serviceName', 'scheduledAt', 'complaint', 'status', 'slotId', 'createdAt', 'updatedAt'])
          && d.keys().hasOnly(['customerId', 'vehicleId', 'vehicleName', 'vehiclePlate', 'serviceId', 'serviceName', 'scheduledAt', 'complaint', 'status', 'slotId', 'createdAt', 'updatedAt'])
          && d.customerId == request.auth.uid && d.status == 'pending'
          && vehicle.ownerId == request.auth.uid && vehicle.active == true
          && d.vehicleName == vehicle.name && d.vehiclePlate == vehicle.plate
          && catalog.active == true && d.serviceName == catalog.name
          && d.complaint is string && d.complaint.size() >= 5 && d.complaint.size() <= 500
          && d.scheduledAt is timestamp && d.scheduledAt > request.time
          && d.scheduledAt <= request.time + duration.value(90, 'd')
          // Workshop time is always WIB (UTC+7), independent of device timezone.
          && d.scheduledAt.hours() in [2, 3, 4, 6, 7, 8, 9]
          && d.scheduledAt.toMillis() % 3600000 == 0
          && d.slotId == string(d.scheduledAt.toMillis())
          && d.createdAt == request.time && d.updatedAt == request.time
          && lockMatches(d, true);
      }
      allow get: if admin() || (customer() && resource.data.customerId == request.auth.uid);
      allow list: if bounded(100) && (admin() || (customer() && resource.data.customerId == request.auth.uid));
      allow create: if customer() && validCreate(request.resource.data);
      allow update: if enabled()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.updatedAt == request.time
        && ((admin() && resource.data.status == 'pending' && request.resource.data.status in ['confirmed', 'rejected'])
          || (customer() && resource.data.customerId == request.auth.uid && activeStatus(resource.data.status) && request.resource.data.status == 'cancelled'
            && !existsAfter(/databases/$(database)/documents/serviceOrders/$(id))))
        && lockMatches(request.resource.data, activeStatus(request.resource.data.status));
      allow delete: if false;
    }

    // Shared capacity-one locks contain no customer identity or complaint.
    // Single-document reads support transactions; collection enumeration is denied.
    match /bookingSlots/{id} {
      function valid(d) {
        return d.keys().hasAll(['bookingId', 'scheduledAt', 'active'])
          && d.keys().hasOnly(['bookingId', 'scheduledAt', 'active'])
          && d.bookingId is string && d.scheduledAt is timestamp && d.active is bool
          && id == string(d.scheduledAt.toMillis());
      }
      function newBooking(d) {
        let b = getAfter(/databases/$(database)/documents/bookings/$(d.bookingId)).data;
        return !exists(/databases/$(database)/documents/bookings/$(d.bookingId))
          && b.customerId == request.auth.uid && b.status == 'pending'
          && b.scheduledAt == d.scheduledAt && b.slotId == id && b.createdAt == request.time;
      }
      function released(d) {
        let b = getAfter(/databases/$(database)/documents/bookings/$(d.bookingId)).data;
        return d.active == false && b.status in ['rejected', 'cancelled']
          && b.slotId == id && b.scheduledAt == d.scheduledAt
          && (admin() || (customer() && b.customerId == request.auth.uid))
          && d.diff(resource.data).affectedKeys().hasOnly(['active']);
      }
      allow get: if enabled();
      allow list, delete: if false;
      allow create: if customer() && valid(request.resource.data)
        && request.resource.data.active == true && newBooking(request.resource.data);
      allow update: if enabled() && valid(request.resource.data)
        && ((customer() && resource.data.active == false && request.resource.data.active == true && newBooking(request.resource.data))
          || (resource.data.active == true && released(request.resource.data)));
    }
    function terminal(s) { return s in ['completed', 'cancelled']; }
    function orderPath(id) { return /databases/$(database)/documents/serviceOrders/$(id); }
    function techPath(id) { return /databases/$(database)/documents/technicians/$(id); }
    function readableOrder(d) {
      return admin() || (customer() && d.customerId == request.auth.uid)
        || (technician() && d.technicianId == request.auth.uid);
    }
    function trustedTech(id) {
      let u = get(/databases/$(database)/documents/users/$(id)).data;
      return u.role == 'technician' && u.active == true;
    }
    match /technicians/{uid} {
      function valid(d) {
        return d.keys().hasAll(['name', 'specialization', 'active', 'available', 'currentOrderId', 'createdAt', 'updatedAt', 'updatedBy'])
          && d.keys().hasOnly(['name', 'specialization', 'active', 'available', 'currentOrderId', 'createdAt', 'updatedAt', 'updatedBy'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 80
          && d.specialization is string && d.specialization.size() > 0 && d.specialization.size() <= 120
          && d.active is bool && d.available is bool && (d.currentOrderId == null || d.currentOrderId is string)
          && d.createdAt is timestamp && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
      }
      function lockChange() {
        let before = resource.data.currentOrderId;
        let after = request.resource.data.currentOrderId;
        return admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentOrderId'])
          && ((before == null && after is string && resource.data.active && resource.data.available && trustedTech(uid)
              && getAfter(orderPath(after)).data.technicianId == uid
              && getAfter(orderPath(after)).data.status == 'assigned'
              && getAfter(orderPath(after)).data.updatedAt == request.time
              && getAfter(orderPath(after)).data.assignedBy == request.auth.uid
              && get(orderPath(after)).data.technicianId != uid)
            || (before is string && after == null && get(orderPath(before)).data.technicianId == uid
              && getAfter(orderPath(before)).data.updatedAt == request.time
              && (terminal(getAfter(orderPath(before)).data.status) || getAfter(orderPath(before)).data.technicianId != uid)));
      }
      allow get: if admin() || (technician() && uid == request.auth.uid);
      allow list: if admin() && bounded(20);
      allow create: if admin() && valid(request.resource.data) && trustedTech(uid)
        && request.resource.data.currentOrderId == null && request.resource.data.createdAt == request.time;
      allow update: if lockChange() || (admin() && valid(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'specialization', 'active', 'available', 'updatedAt', 'updatedBy'])
        && (!request.resource.data.active || trustedTech(uid))
        && (request.resource.data.active || resource.data.currentOrderId == null));
      allow delete: if false;
    }
    match /serviceOrders/{id} {
      function valid(d) {
        return d.keys().hasAll(['bookingId', 'customerId', 'vehicleId', 'vehicleName', 'vehiclePlate', 'serviceId', 'serviceName', 'complaint', 'scheduledAt', 'status', 'technicianId', 'checklist', 'diagnosis', 'actions', 'notes', 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'assignedAt', 'assignedBy', 'startedAt', 'completedAt'])
          && d.keys().hasOnly(['bookingId', 'customerId', 'vehicleId', 'vehicleName', 'vehiclePlate', 'serviceId', 'serviceName', 'complaint', 'scheduledAt', 'status', 'technicianId', 'checklist', 'diagnosis', 'actions', 'notes', 'revision', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'assignedAt', 'assignedBy', 'startedAt', 'completedAt', 'laborPrice', 'technicianName'])
          && (d.get('laborPrice', null) == null || moneyValid(d.laborPrice))
          && (d.get('technicianName', null) == null || (d.technicianName is string && d.technicianName.size() <= 80))
          && d.status in ['queued', 'assigned', 'inProgress', 'paused', 'awaitingApproval', 'completed', 'cancelled']
          && (d.technicianId == null || d.technicianId is string)
          && d.revision is int && d.revision >= 0
          && d.checklist is map && d.checklist.keys().hasAll(['vehicleChecked', 'safetyChecked', 'workChecked'])
          && d.checklist.keys().hasOnly(['vehicleChecked', 'safetyChecked', 'workChecked'])
          && d.checklist.vehicleChecked is bool && d.checklist.safetyChecked is bool && d.checklist.workChecked is bool
          && d.diagnosis is string && d.diagnosis.size() <= 2000 && d.actions is string && d.actions.size() <= 2000
          && d.notes is string && d.notes.size() <= 4000
          && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
      }
      function audit(d, kind) {
        let e = getAfter(/databases/$(database)/documents/serviceOrders/$(id)/events/$(string(d.revision))).data;
        return e.revision == d.revision && e.actorId == request.auth.uid && e.at == request.time
          && e.status == d.status && e.technicianId == d.technicianId && e.kind == kind;
      }
      function newOrder(d) {
        let b = getAfter(/databases/$(database)/documents/bookings/$(id)).data;
        return admin() && d.bookingId == id && b.status == 'confirmed'
          && d.customerId == b.customerId && d.vehicleId == b.vehicleId && d.vehicleName == b.vehicleName
          && d.vehiclePlate == b.vehiclePlate && d.serviceId == b.serviceId && d.serviceName == b.serviceName
          && d.complaint == b.complaint && d.scheduledAt == b.scheduledAt
          && d.status == 'queued' && d.technicianId == null && d.revision == 0
          && d.get('laborPrice', null) == null && d.get('technicianName', null) == null
          && d.checklist == {'vehicleChecked': false, 'safetyChecked': false, 'workChecked': false}
          && d.diagnosis == '' && d.actions == '' && d.notes == ''
          && d.createdAt == request.time && d.createdBy == request.auth.uid
          && d.assignedAt == null && d.assignedBy == null && d.startedAt == null && d.completedAt == null
          && audit(d, 'created');
      }
      function assignment(d, old) {
        let t = get(techPath(d.technicianId)).data;
        return admin() && old.status in ['queued', 'assigned', 'paused'] && d.status == 'assigned'
          && d.technicianId != old.technicianId && trustedTech(d.technicianId)
          && t.active == true && t.available == true && t.currentOrderId == null
          && getAfter(techPath(d.technicianId)).data.currentOrderId == id
          && (old.technicianId == null || getAfter(techPath(old.technicianId)).data.currentOrderId == null)
          && d.assignedAt == request.time && d.assignedBy == request.auth.uid
          && d.technicianName == t.name
          && d.diff(old).affectedKeys().hasOnly(['technicianId', 'technicianName', 'status', 'assignedAt', 'assignedBy', 'updatedAt', 'updatedBy', 'revision'])
          && audit(d, 'assigned');
      }
      function adminTransition(d, old) {
        return admin() && ((!terminal(old.status) && d.status == 'cancelled')
            || (old.status == 'awaitingApproval' && d.status in ['completed', 'assigned']))
          && d.diff(old).affectedKeys().hasOnly(['status', 'technicianName', 'completedAt', 'updatedAt', 'updatedBy', 'revision'])
          && (d.status == 'completed' ? (d.completedAt == request.time && moneyValid(d.get('laborPrice', null))
            && d.technicianName == old.get('technicianName', get(techPath(old.technicianId)).data.name))
            : (d.completedAt == old.completedAt && d.get('technicianName', null) == old.get('technicianName', null)))
          && (old.technicianId == null || !terminal(d.status) || getAfter(techPath(old.technicianId)).data.currentOrderId == null)
          && audit(d, 'statusChanged');
      }
      function pricing(d, old) {
        return admin() && moneyValid(d.get('laborPrice', null))
          && d.diff(old).affectedKeys().hasOnly(['laborPrice', 'revision', 'updatedAt', 'updatedBy'])
          && audit(d, 'pricingUpdated');
      }
      function techTransition(d, old) {
        let starting = old.status in ['assigned', 'paused'] && d.status == 'inProgress';
        let moving = starting || (old.status == 'inProgress' && d.status in ['paused', 'awaitingApproval']);
        let saving = old.status in ['inProgress', 'paused'] && d.status == old.status;
        return technician() && old.technicianId == request.auth.uid
          && get(techPath(request.auth.uid)).data.active == true
          && get(techPath(request.auth.uid)).data.currentOrderId == id
          && (moving || saving)
          && d.diff(old).affectedKeys().hasOnly(['status', 'checklist', 'diagnosis', 'actions', 'notes', 'startedAt', 'updatedAt', 'updatedBy', 'revision'])
          && (starting && old.startedAt == null ? d.startedAt == request.time : d.startedAt == old.startedAt)
          && (d.status != 'awaitingApproval' || (d.diagnosis.size() > 0 && d.actions.size() > 0
            && d.checklist.vehicleChecked && d.checklist.safetyChecked && d.checklist.workChecked))
          && audit(d, saving ? 'workUpdated' : 'statusChanged');
      }
      allow get: if admin() || readableOrder(resource.data)
        || (customer() && !exists(orderPath(id)) && get(/databases/$(database)/documents/bookings/$(id)).data.customerId == request.auth.uid);
      allow list: if bounded(20) && readableOrder(resource.data);
      allow create: if valid(request.resource.data) && newOrder(request.resource.data);
      allow update: if !terminal(resource.data.status) && valid(request.resource.data)
        && request.resource.data.revision == resource.data.revision + 1
        && (admin() ?
          (request.resource.data.status == resource.data.status && request.resource.data.technicianId == resource.data.technicianId
            ? pricing(request.resource.data, resource.data)
            : (assignment(request.resource.data, resource.data) || adminTransition(request.resource.data, resource.data)))
          : techTransition(request.resource.data, resource.data));
      allow delete: if false;
      match /events/{revision} {
        allow get: if readableOrder(get(orderPath(id)).data);
        allow list: if bounded(20) && readableOrder(get(orderPath(id)).data);
        allow create: if enabled()
          && request.resource.data.keys().hasAll(['revision', 'actorId', 'at', 'kind', 'status', 'technicianId'])
          && request.resource.data.keys().hasOnly(['revision', 'actorId', 'at', 'kind', 'status', 'technicianId'])
          && revision == string(request.resource.data.revision)
          && request.resource.data.revision == getAfter(orderPath(id)).data.revision
          && (!exists(orderPath(id)) || get(orderPath(id)).data.revision + 1 == request.resource.data.revision)
          && request.resource.data.actorId == request.auth.uid && request.resource.data.at == request.time
          && request.resource.data.status == getAfter(orderPath(id)).data.status
          && request.resource.data.technicianId == getAfter(orderPath(id)).data.technicianId
          && getAfter(orderPath(id)).data.updatedBy == request.auth.uid
          && getAfter(orderPath(id)).data.updatedAt == request.time;
        allow update, delete: if false;
      }
    }
    // Phase 04: every stock delta has one fresh ledger witness, and vice versa.
    function partPath(sku) { return /databases/$(database)/documents/spareparts/$(sku); }
    function movementPath(id) { return /databases/$(database)/documents/stockMovements/$(id); }
    function requestPath(so, id) { return /databases/$(database)/documents/serviceOrders/$(so)/partRequests/$(id); }
    function usagePath(so, id) { return /databases/$(database)/documents/serviceOrders/$(so)/partUsages/$(id); }
    function skuValid(sku) { return sku is string && sku.matches('^[A-Z0-9][A-Z0-9_-]{0,39}$'); }
    function qtyValid(q) { return q is int && q > 0 && q <= 1000000; }
    function reasonValid(s) { return s is string && s.size() > 0 && s.size() <= 500 && s.matches('(?s).*[^ \\t\\r\\n].*'); }
    function moneyValid(n) { return n is int && n >= 0 && n <= 1000000000; }
    match /spareparts/{sku} {
      function valid(d) {
        return d.keys().hasAll(['sku', 'name', 'category', 'unit', 'supplier', 'buyPrice', 'sellPrice', 'minimumStock', 'active', 'stock', 'lowStock', 'stockRevision', 'lastMovementId', 'version', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && d.keys().hasOnly(['sku', 'name', 'category', 'unit', 'supplier', 'buyPrice', 'sellPrice', 'minimumStock', 'active', 'stock', 'lowStock', 'stockRevision', 'lastMovementId', 'version', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
          && skuValid(sku) && d.sku == sku
          && d.name is string && d.name.size() > 0 && d.name.size() <= 100
          && d.category is string && d.category.size() > 0 && d.category.size() <= 60
          && d.unit is string && d.unit.size() > 0 && d.unit.size() <= 20
          && d.supplier is string && d.supplier.size() <= 160
          && moneyValid(d.buyPrice) && moneyValid(d.sellPrice)
          && d.minimumStock is int && d.minimumStock >= 0 && d.minimumStock <= 1000000000
          && d.stock is int && d.stock >= 0 && d.stock <= 1000000000
          && d.active is bool && d.lowStock == (d.stock <= d.minimumStock)
          && d.stockRevision is int && d.stockRevision >= 0 && d.version is int && d.version >= 0
          && (d.lastMovementId == null || d.lastMovementId is string)
          && d.createdAt is timestamp && d.createdBy is string
          && d.updatedAt == request.time && d.updatedBy == request.auth.uid;
      }
      function stockChange(d, old) {
        let m = getAfter(movementPath(d.lastMovementId)).data;
        return d.diff(old).affectedKeys().hasOnly(['stock', 'lowStock', 'stockRevision', 'lastMovementId', 'version', 'updatedAt', 'updatedBy'])
          && d.stock != old.stock && d.stockRevision == old.stockRevision + 1
          && !exists(movementPath(d.lastMovementId))
          && m.sku == sku && m.stockRevision == d.stockRevision
          && m.balanceBefore == old.stock && m.balanceAfter == d.stock
          && m.delta == d.stock - old.stock && m.actorId == request.auth.uid && m.createdAt == request.time;
      }
      allow get: if admin();
      allow list: if admin() && bounded(20);
      allow create: if admin() && valid(request.resource.data)
        && request.resource.data.stock == 0 && request.resource.data.stockRevision == 0
        && request.resource.data.version == 0 && request.resource.data.lastMovementId == null
        && request.resource.data.createdAt == request.time && request.resource.data.createdBy == request.auth.uid;
      allow update: if admin() && valid(request.resource.data) && request.resource.data.version == resource.data.version + 1
        && (stockChange(request.resource.data, resource.data)
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'category', 'unit', 'supplier', 'buyPrice', 'sellPrice', 'minimumStock', 'active', 'lowStock', 'version', 'updatedAt', 'updatedBy']));
      // Archive instead of deleting or freeing a historical SKU.
      allow delete: if false;
    }
    match /stockMovements/{id} {
      function valid(d) {
        return d.keys().hasAll(['sku', 'kind', 'quantity', 'delta', 'reason', 'serviceOrderId', 'requestId', 'reversalOf', 'balanceBefore', 'balanceAfter', 'stockRevision', 'name', 'unit', 'buyPrice', 'sellPrice', 'actorId', 'createdAt'])
          && d.keys().hasOnly(['sku', 'kind', 'quantity', 'delta', 'reason', 'serviceOrderId', 'requestId', 'reversalOf', 'balanceBefore', 'balanceAfter', 'stockRevision', 'name', 'unit', 'buyPrice', 'sellPrice', 'actorId', 'createdAt'])
          && id.matches('^[A-Za-z0-9_~\\-]{1,180}$') && skuValid(d.sku)
          && d.kind in ['receipt', 'adjustment', 'usage', 'reversal'] && qtyValid(d.quantity)
          && d.delta is int && (d.delta == d.quantity || d.delta == -d.quantity)
          && reasonValid(d.reason) && d.balanceBefore is int && d.balanceAfter is int
          && d.balanceBefore >= 0 && d.balanceAfter >= 0 && d.balanceAfter <= 1000000000
          && d.balanceAfter == d.balanceBefore + d.delta && d.stockRevision is int
          && (d.serviceOrderId == null || d.serviceOrderId is string)
          && (d.requestId == null || d.requestId is string) && (d.reversalOf == null || d.reversalOf is string)
          && d.name is string && d.unit is string && moneyValid(d.buyPrice) && moneyValid(d.sellPrice)
          && d.actorId == request.auth.uid && d.createdAt == request.time;
      }
      function balances(d) {
        let before = get(partPath(d.sku)).data;
        let after = getAfter(partPath(d.sku)).data;
        return d.balanceBefore == before.stock && d.balanceAfter == after.stock
          && after.lastMovementId == id && after.stockRevision == before.stockRevision + 1
          && d.stockRevision == after.stockRevision && after.version == before.version + 1;
      }
      function snapshot(d) {
        let p = get(partPath(d.sku)).data;
        return p.active == true && d.name == p.name && d.unit == p.unit
          && d.buyPrice == p.buyPrice && d.sellPrice == p.sellPrice;
      }
      function usageLine(d) {
        let u = getAfter(usagePath(d.serviceOrderId, id)).data;
        return !exists(usagePath(d.serviceOrderId, id)) && u.movementId == id && u.sku == d.sku
          && u.name == d.name && u.unit == d.unit && u.quantity == d.quantity && u.sellPrice == d.sellPrice
          && u.kind == d.kind && u.reversalOf == d.reversalOf && u.actorId == request.auth.uid && u.createdAt == request.time;
      }
      function approval(d) {
        let before = get(requestPath(d.serviceOrderId, d.requestId)).data;
        let after = getAfter(requestPath(d.serviceOrderId, d.requestId)).data;
        return id == 'Q~' + d.serviceOrderId + '~' + d.requestId
          && before.status == 'pending' && before.sku == d.sku && before.quantity == d.quantity
          && after.status == 'approved' && after.movementId == id && after.decidedAt == request.time
          && after.decidedBy == request.auth.uid && after.decisionReason == d.reason;
      }
      function regular(d) {
        return d.reversalOf == null && id.size() <= 178 && !id.matches('^R~.*') && snapshot(d)
          && ((d.kind == 'receipt' && d.delta == d.quantity && d.serviceOrderId == null && d.requestId == null && !id.matches('^Q~.*'))
            || (d.kind == 'adjustment' && d.serviceOrderId == null && d.requestId == null && !id.matches('^Q~.*'))
            || (d.kind == 'usage' && d.delta == -d.quantity && d.serviceOrderId is string
              && !terminal(getAfter(orderPath(d.serviceOrderId)).data.status) && usageLine(d)
              && (d.requestId == null ? !id.matches('^Q~.*') : approval(d))));
      }
      function reversing(d) {
        let original = get(movementPath(d.reversalOf)).data;
        return d.kind == 'reversal' && d.reversalOf is string && id == 'R~' + d.reversalOf
          && original.kind in ['receipt', 'adjustment', 'usage'] && original.sku == d.sku
          && d.delta == -original.delta && d.quantity == original.quantity
          && d.serviceOrderId == original.serviceOrderId && d.requestId == null
          && d.name == original.name && d.unit == original.unit
          && d.buyPrice == original.buyPrice && d.sellPrice == original.sellPrice
          && (original.kind != 'usage' || (!terminal(getAfter(orderPath(d.serviceOrderId)).data.status) && usageLine(d)));
      }
      allow get: if admin();
      allow list: if admin() && bounded(20);
      allow create: if admin() && valid(request.resource.data) && balances(request.resource.data)
        && (regular(request.resource.data) || reversing(request.resource.data));
      allow update, delete: if false;
    }
    match /serviceOrders/{so}/partUsages/{id} {
      function valid(d) {
        let m = getAfter(movementPath(id)).data;
        return d.keys().hasAll(['movementId', 'sku', 'name', 'unit', 'quantity', 'sellPrice', 'kind', 'reversalOf', 'actorId', 'createdAt'])
          && d.keys().hasOnly(['movementId', 'sku', 'name', 'unit', 'quantity', 'sellPrice', 'kind', 'reversalOf', 'actorId', 'createdAt'])
          && !exists(movementPath(id)) && d.movementId == id && m.serviceOrderId == so
          && d.sku == m.sku && d.name == m.name && d.unit == m.unit && d.quantity == m.quantity
          && d.sellPrice == m.sellPrice && d.kind == m.kind && d.kind in ['usage', 'reversal']
          && (d.kind == 'usage' || get(movementPath(m.reversalOf)).data.kind == 'usage')
          && d.reversalOf == m.reversalOf && d.actorId == request.auth.uid && d.createdAt == request.time;
      }
      allow get: if readableOrder(get(orderPath(so)).data);
      allow list: if bounded(20) && readableOrder(get(orderPath(so)).data);
      allow create: if admin() && valid(request.resource.data);
      allow update, delete: if false;
    }
    match /serviceOrders/{so}/partRequests/{id} {
      function valid(d) {
        return d.keys().hasAll(['sku', 'quantity', 'reason', 'status', 'createdBy', 'createdAt', 'decidedBy', 'decidedAt', 'decisionReason', 'movementId'])
          && d.keys().hasOnly(['sku', 'quantity', 'reason', 'status', 'createdBy', 'createdAt', 'decidedBy', 'decidedAt', 'decisionReason', 'movementId'])
          && skuValid(d.sku) && qtyValid(d.quantity) && reasonValid(d.reason)
          && d.status in ['pending', 'approved', 'rejected'] && d.createdAt is timestamp && d.createdBy is string;
      }
      function assigned() { return technician() && get(orderPath(so)).data.technicianId == request.auth.uid; }
      function approved(d) {
        let m = getAfter(movementPath(d.movementId)).data;
        return d.status == 'approved' && d.movementId == 'Q~' + so + '~' + id
          && !exists(movementPath(d.movementId)) && m.kind == 'usage' && m.serviceOrderId == so
          && m.requestId == id && m.sku == d.sku && m.quantity == d.quantity && m.reason == d.decisionReason;
      }
      allow get: if admin() || assigned();
      allow list: if bounded(20) && (admin() || assigned());
      allow create: if assigned() && valid(request.resource.data)
        && getAfter(orderPath(so)).data.technicianId == request.auth.uid
        && getAfter(orderPath(so)).data.status in ['inProgress', 'paused']
        && get(techPath(request.auth.uid)).data.active == true
        && request.resource.data.status == 'pending' && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time && request.resource.data.decidedBy == null
        && request.resource.data.decidedAt == null && request.resource.data.decisionReason == '' && request.resource.data.movementId == null;
      allow update: if admin() && valid(request.resource.data) && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedBy', 'decidedAt', 'decisionReason', 'movementId'])
        && request.resource.data.decidedBy == request.auth.uid && request.resource.data.decidedAt == request.time
        && reasonValid(request.resource.data.decisionReason)
        && ((request.resource.data.status == 'rejected' && request.resource.data.movementId == null) || approved(request.resource.data));
      allow delete: if false;
    }
    function invoicePath(id) { return /databases/$(database)/documents/invoices/$(id); }
    function paymentPath(id, key) { return /databases/$(database)/documents/invoices/$(id)/payments/$(key); }
    function invoiceReadable(d) { return admin() || (customer() && d.customerId == request.auth.uid); }
    function invoiceMoney(v) { return v is int && v >= 0 && v <= 9000000000000000; }
    match /invoices/{id} {
      function valid(d) {
        return d.keys().hasOnly(['invoiceNo', 'serviceOrderId', 'customerId', 'serviceName', 'vehiclePlate',
          'laborPrice', 'parts', 'partSubtotal', 'subtotal', 'discount', 'fee', 'grandTotal', 'paidAmount',
          'change', 'due', 'method', 'status', 'recordedBy', 'paidAt', 'createdAt', 'updatedAt', 'notes', 'revision', 'lastKey'])
          && d.invoiceNo == 'INV~' + id && d.serviceOrderId == id
          && invoiceMoney(d.partSubtotal) && invoiceMoney(d.subtotal) && moneyValid(d.laborPrice)
          && moneyValid(d.discount) && moneyValid(d.fee)
          && d.subtotal == d.laborPrice + d.partSubtotal
          && d.grandTotal == d.subtotal - d.discount + d.fee && d.grandTotal > 0 && invoiceMoney(d.grandTotal)
          && invoiceMoney(d.paidAmount) && invoiceMoney(d.change) && invoiceMoney(d.due)
          && d.recordedBy == request.auth.uid && d.updatedAt == request.time
          && reasonValid(d.notes) && d.revision is int && d.parts is list && d.parts.size() <= 100;
      }
      function issued(d) {
        let so = get(orderPath(id)).data;
        let e = getAfter(paymentPath(id, 'issued')).data;
        return so.status == 'completed' && d.customerId == so.customerId
          && d.serviceName == so.serviceName && d.vehiclePlate == so.vehiclePlate && d.laborPrice == so.laborPrice
          && d.status == 'unpaid' && d.paidAmount == 0 && d.change == 0 && d.due == d.grandTotal
          && d.method == 'none' && d.paidAt == null && d.createdAt == request.time
          && d.revision == 0 && d.lastKey == 'issued' && e.kind == 'issued' && e.revision == 0;
      }
      function paid(d, old, e) {
        return e.kind == 'payment' && old.status in ['unpaid', 'partial'] && e.amount > 0
          && e.method in ['cash', 'transfer'] && e.applied > 0 && e.applied <= old.due
          && e.applied == (e.amount > old.due ? old.due : e.amount)
          && e.change == e.amount - e.applied && (e.method == 'cash' || e.change == 0)
          && d.paidAmount == old.paidAmount + e.applied && d.due == old.due - e.applied
          && d.change == old.change + e.change
          && (d.due == 0 ? (d.status == 'paid' && d.paidAt == request.time)
            : (d.status == 'partial' && d.paidAt == old.paidAt));
      }
      function cancelled(d, old, e) {
        return d.due == 0 && d.change == old.change && d.paidAmount == 0 && d.paidAt == old.paidAt
          && ((e.kind == 'void' && old.status == 'unpaid' && d.status == 'void'
              && e.method == 'none' && e.amount == 0 && e.applied == 0 && e.change == 0)
            || (e.kind == 'refund' && old.status in ['partial', 'paid'] && d.status == 'refunded'
              && e.method in ['cash', 'transfer'] && e.amount == old.paidAmount
              && e.applied == -old.paidAmount && e.change == 0));
      }
      function changed(d, old) {
        let e = getAfter(paymentPath(id, d.lastKey)).data;
        return d.diff(old).affectedKeys().hasOnly(['paidAmount', 'change', 'due', 'status', 'method', 'recordedBy',
            'updatedAt', 'paidAt', 'notes', 'revision', 'lastKey'])
          && d.revision == old.revision + 1 && d.lastKey.matches('^[A-Za-z0-9_-]{10,100}$')
          && !exists(paymentPath(id, d.lastKey)) && e.key == d.lastKey && e.revision == d.revision
          && e.recordedBy == d.recordedBy && e.notes == d.notes && e.method == d.method && e.paidAt == request.time
          && (paid(d, old, e) || cancelled(d, old, e));
      }
      allow get: if admin() || (customer() && (!exists(invoicePath(id)) || resource.data.customerId == request.auth.uid));
      allow list: if bounded(20) && invoiceReadable(resource.data);
      allow create: if admin() && valid(request.resource.data) && issued(request.resource.data);
      allow update: if admin() && valid(request.resource.data) && changed(request.resource.data, resource.data);
      allow delete: if false;
      match /payments/{key} {
        function validEvent(d) {
          let inv = getAfter(invoicePath(id)).data;
          return d.keys().hasAll(['key', 'revision', 'kind', 'amount', 'applied', 'change', 'method', 'notes', 'recordedBy', 'paidAt'])
            && d.keys().hasOnly(['key', 'revision', 'kind', 'amount', 'applied', 'change', 'method', 'notes', 'recordedBy', 'paidAt'])
            && d.key == key && inv.lastKey == key && inv.revision == d.revision
            && inv.updatedAt == request.time && inv.recordedBy == request.auth.uid
            && d.recordedBy == request.auth.uid && d.paidAt == request.time
            && d.notes == inv.notes && d.method == inv.method && invoiceMoney(d.amount) && invoiceMoney(d.change)
            && d.applied is int
            && (key == 'issued' ? (!exists(invoicePath(id)) && d.kind == 'issued'
                && d.revision == 0 && d.amount == 0 && d.applied == 0 && d.change == 0)
              : (exists(invoicePath(id)) && inv.revision == get(invoicePath(id)).data.revision + 1));
        }
        allow get: if admin() || (customer() && invoiceReadable(get(invoicePath(id)).data));
        allow list: if bounded(20) && invoiceReadable(get(invoicePath(id)).data);
        allow create: if admin() && validEvent(request.resource.data);
        allow update, delete: if false;
      }
    }
    // Reports query the canonical collections; no client-written report totals.
    match /reports/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
