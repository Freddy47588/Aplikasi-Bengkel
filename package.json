{
  "name": "bengkelku-security-tests",
  "private": true,
  "scripts": {
    "test:rules": "firebase emulators:exec --project demo-bengkelku --only firestore,auth \"node --require ./tools/require-emulator.cjs --test --test-concurrency=1 test_rules/*.test.cjs\"",
    "check:firebase": "node tools/check-firebase-config.cjs",
    "emulators:start": "firebase emulators:start --project demo-bengkelku --only firestore,auth",
    "data:seed": "node tools/test-data.cjs seed",
    "data:reset": "node tools/test-data.cjs reset",
    "data:validate": "node tools/test-data.cjs validate"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "15.34.0"
  }
}
